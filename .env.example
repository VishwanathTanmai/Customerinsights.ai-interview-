# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=uplift
POSTGRES_PASSWORD=change_me
POSTGRES_DB=uplift
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442

# LLM Configuration (OpenRouter or Mistral directly)
OPENROUTER_API_KEY=
LLM_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=mistralai/mistral-small-24b-instruct-2501

# Direct Mistral Configuration
MISTRAL_API_KEY=
MISTRAL_MODEL=mistralai/mistral-small-24b-instruct-2501
MISTRAL_TEMPERATURE=0.2
PROMPT_VERSION=v1
REASONS_MAX=400
REASONS_CONCURRENCY=8
TOKEN_BUDGET=400000

ADMIN_TOKEN=change_me_admin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED=42
